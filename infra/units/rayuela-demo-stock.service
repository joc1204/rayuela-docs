[Unit]
Description=Rayuela demo - stock de los titulos publicados
After=network.target

[Service]
Type=simple
User=rayuela
Group=rayuela
WorkingDirectory=/opt/rayuela/demo
ExecStart=/usr/bin/flock -n /run/rayuela-bridge.lock /opt/rayuela/ferias/venv/bin/python stock_publicados.py --seguir --espera 1800 --pausa 0.5 --nocturno
Restart=always
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
