[Unit]
Description=Rayuela - radar de tendencias externas
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rayuela
WorkingDirectory=/opt/rayuela/demo
Environment=CATALOGO_DB=/opt/rayuela/demo/catalogo.db
ExecStart=/opt/rayuela/ferias/venv/bin/python /opt/rayuela/demo/radar_tendencias.py