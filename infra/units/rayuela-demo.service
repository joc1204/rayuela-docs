[Unit]
Description=Rayuela - demo de tienda (catalogo)
After=network.target

[Service]
User=rayuela
Group=rayuela
WorkingDirectory=/opt/rayuela/demo
Environment=DEMO_PUERTO=5052
Environment=CATALOGO_DB=/opt/rayuela/demo/catalogo.db
Environment=BRIDGE_BASE=http://rayuela1.serveftp.net:9090/BSGestion
Environment=DEMO_URL=https://demo.rayuelalaplata.com.ar
EnvironmentFile=/etc/rayuela/demo.env
ExecStart=/opt/rayuela/ferias/venv/bin/python app.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/opt/rayuela/demo

[Install]
WantedBy=multi-user.target
