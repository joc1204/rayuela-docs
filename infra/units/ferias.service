[Unit]
Description=Ferias de la libreria (Rayuela)
After=network.target

[Service]
Type=simple
User=rayuela
Group=rayuela
WorkingDirectory=/opt/rayuela/ferias
Environment=FERIAS_PUERTO=5050
Environment=FERIAS_DB=/opt/rayuela/ferias/ferias.db
Environment=FERIAS_PREFIJO=
Environment=FERIAS_SECURE=1
Environment=FERIAS_SECRETO=0e7d61772ab52fee85548e9c38b6036b60ccffbd957fe691664b4ab89756fc88
ExecStart=/opt/rayuela/ferias/venv/bin/python app.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/opt/rayuela/ferias

[Install]
WantedBy=multi-user.target