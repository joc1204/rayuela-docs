[Unit]
Description=Rayuela demo - tapas primero, despues sinopsis de los publicados
After=network.target

[Service]
Type=simple
User=rayuela
Group=rayuela
WorkingDirectory=/opt/rayuela/demo
# primero las tapas (rapido), despues las fichas completas (lento): en ese orden
ExecStart=/opt/rayuela/ferias/venv/bin/python fichas_publicadas.py --hilos 2 --pausa 0.6
Restart=on-failure
RestartSec=120
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
