# Configuracion de la sincronizacion de la demo con Rayuela.
# Copiar a /etc/rayuela/demo-sync.env (600 root) cuando Luis pase la URL de produccion.
#
# BRIDGE_BASE: servidor de Rayuela (sin /rest/webservice al final).
#   Produccion: http://rayuela1.serveftp.net:9090/BSGestion
#   Pruebas:    http://brd.serveftp.net:10160/BSGestionRayuela
BRIDGE_BASE=http://brd.serveftp.net:10160/BSGestionRayuela

# SYNC_API_HABILITADA=1 habilita el boton "Actualizar ahora" del panel.
# Dejarlo en 0 hasta tener la URL de produccion y la autorizacion de Bridge.
SYNC_API_HABILITADA=0

# Limite de pedidos por segundo contra Rayuela (compartido entre procesos).
RAYUELA_BRIDGE_POR_SEGUNDO=3
RAYUELA_LIMITE_ARCHIVO=/var/lock/rayuela-bridge-ritmo

CATALOGO_DB=/opt/rayuela/demo/catalogo.db
