server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name 201.32.132.197.sslip.io 201.32.132.197;

    ssl_certificate /etc/letsencrypt/live/201.32.132.197.sslip.io/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/201.32.132.197.sslip.io/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    client_max_body_size 12m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    send_timeout 20s;
    keepalive_timeout 30s;

    limit_conn rayuela_conn 20;
    limit_req zone=rayuela_general burst=40 nodelay;

    if ($rayuela_basura) {
        return 444;
    }

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location = /ingresar {
        limit_req zone=rayuela_login burst=4 nodelay;
        include /etc/nginx/proxy_rayuela.conf;
        proxy_pass http://127.0.0.1:5050;
    }

    location / {
        include /etc/nginx/proxy_rayuela.conf;
        proxy_pass http://127.0.0.1:5050;
    }
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name 201.32.132.197.sslip.io 201.32.132.197;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    return 301 https://$host$request_uri;
}
