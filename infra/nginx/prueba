server {
    listen 80;
    listen [::]:80;
    server_name prueba.rayuelalaplata.com.ar;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name prueba.rayuelalaplata.com.ar;

    ssl_certificate /etc/letsencrypt/live/prueba.rayuelalaplata.com.ar/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/prueba.rayuelalaplata.com.ar/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 12m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    send_timeout 20s;

    limit_conn rayuela_conn 20;
    limit_req zone=rayuela_general burst=40 nodelay;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # cartel de ambiente de prueba (se inyecta al final del HTML)
    sub_filter_once on;
    sub_filter '</body>' '<div style="position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#6d28d9;color:#fff;font:600 13px/1.6 system-ui,sans-serif;text-align:center;padding:6px 10px;box-shadow:0 -2px 8px rgba(0,0,0,.25)">AMBIENTE DE PRUEBA - los datos no son reales</div></body>';
    proxy_set_header Accept-Encoding "";

    location / {
        include /etc/nginx/proxy_rayuela.conf;
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:5051;
    }
}
